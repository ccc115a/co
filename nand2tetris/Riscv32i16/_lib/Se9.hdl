// Se9：9 位元有號數 → 16 位元符號擴展
// 供 LI / JAL 的 imm9 使用；高位 7 顆 Mux 複製符號位。
CHIP Se9 {
    IN in[9];
    OUT out[16];

    PARTS:
    Or(a=in[0], b=false, out=out[0]);
    Or(a=in[1], b=false, out=out[1]);
    Or(a=in[2], b=false, out=out[2]);
    Or(a=in[3], b=false, out=out[3]);
    Or(a=in[4], b=false, out=out[4]);
    Or(a=in[5], b=false, out=out[5]);
    Or(a=in[6], b=false, out=out[6]);
    Or(a=in[7], b=false, out=out[7]);
    Or(a=in[8], b=false, out=out[8]);
    Mux(a=false, b=true, sel=in[8], out=out[9]);
    Mux(a=false, b=true, sel=in[8], out=out[10]);
    Mux(a=false, b=true, sel=in[8], out=out[11]);
    Mux(a=false, b=true, sel=in[8], out=out[12]);
    Mux(a=false, b=true, sel=in[8], out=out[13]);
    Mux(a=false, b=true, sel=in[8], out=out[14]);
    Mux(a=false, b=true, sel=in[8], out=out[15]);
}