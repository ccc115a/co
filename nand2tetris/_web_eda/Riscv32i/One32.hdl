// One32：32 位元常數 1（bit0=1，其餘 0）。模擬器無 bus 常數，逐 bit 造。
CHIP One32 {
    OUT out[32];

    PARTS:
    Not(in=false, out=out[0]);
    Or(a=false, b=false, out=out[1]);
    Or(a=false, b=false, out=out[2]);
    Or(a=false, b=false, out=out[3]);
    Or(a=false, b=false, out=out[4]);
    Or(a=false, b=false, out=out[5]);
    Or(a=false, b=false, out=out[6]);
    Or(a=false, b=false, out=out[7]);
    Or(a=false, b=false, out=out[8]);
    Or(a=false, b=false, out=out[9]);
    Or(a=false, b=false, out=out[10]);
    Or(a=false, b=false, out=out[11]);
    Or(a=false, b=false, out=out[12]);
    Or(a=false, b=false, out=out[13]);
    Or(a=false, b=false, out=out[14]);
    Or(a=false, b=false, out=out[15]);
    Or(a=false, b=false, out=out[16]);
    Or(a=false, b=false, out=out[17]);
    Or(a=false, b=false, out=out[18]);
    Or(a=false, b=false, out=out[19]);
    Or(a=false, b=false, out=out[20]);
    Or(a=false, b=false, out=out[21]);
    Or(a=false, b=false, out=out[22]);
    Or(a=false, b=false, out=out[23]);
    Or(a=false, b=false, out=out[24]);
    Or(a=false, b=false, out=out[25]);
    Or(a=false, b=false, out=out[26]);
    Or(a=false, b=false, out=out[27]);
    Or(a=false, b=false, out=out[28]);
    Or(a=false, b=false, out=out[29]);
    Or(a=false, b=false, out=out[30]);
    Or(a=false, b=false, out=out[31]);
}
