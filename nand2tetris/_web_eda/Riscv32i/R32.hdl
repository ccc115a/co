// R32：32 位元暫存器（32 顆 Mux+DFF）。input load=1：tick 取樣、tock 提交。
CHIP R32 {
    IN in[32], load;
    OUT out[32];

    PARTS:
    Mux(a=loop[0], b=in[0], sel=load, out=mi0);
    DFF(in=mi0, out=loop[0], out=out[0]);
    Mux(a=loop[1], b=in[1], sel=load, out=mi1);
    DFF(in=mi1, out=loop[1], out=out[1]);
    Mux(a=loop[2], b=in[2], sel=load, out=mi2);
    DFF(in=mi2, out=loop[2], out=out[2]);
    Mux(a=loop[3], b=in[3], sel=load, out=mi3);
    DFF(in=mi3, out=loop[3], out=out[3]);
    Mux(a=loop[4], b=in[4], sel=load, out=mi4);
    DFF(in=mi4, out=loop[4], out=out[4]);
    Mux(a=loop[5], b=in[5], sel=load, out=mi5);
    DFF(in=mi5, out=loop[5], out=out[5]);
    Mux(a=loop[6], b=in[6], sel=load, out=mi6);
    DFF(in=mi6, out=loop[6], out=out[6]);
    Mux(a=loop[7], b=in[7], sel=load, out=mi7);
    DFF(in=mi7, out=loop[7], out=out[7]);
    Mux(a=loop[8], b=in[8], sel=load, out=mi8);
    DFF(in=mi8, out=loop[8], out=out[8]);
    Mux(a=loop[9], b=in[9], sel=load, out=mi9);
    DFF(in=mi9, out=loop[9], out=out[9]);
    Mux(a=loop[10], b=in[10], sel=load, out=mi10);
    DFF(in=mi10, out=loop[10], out=out[10]);
    Mux(a=loop[11], b=in[11], sel=load, out=mi11);
    DFF(in=mi11, out=loop[11], out=out[11]);
    Mux(a=loop[12], b=in[12], sel=load, out=mi12);
    DFF(in=mi12, out=loop[12], out=out[12]);
    Mux(a=loop[13], b=in[13], sel=load, out=mi13);
    DFF(in=mi13, out=loop[13], out=out[13]);
    Mux(a=loop[14], b=in[14], sel=load, out=mi14);
    DFF(in=mi14, out=loop[14], out=out[14]);
    Mux(a=loop[15], b=in[15], sel=load, out=mi15);
    DFF(in=mi15, out=loop[15], out=out[15]);
    Mux(a=loop[16], b=in[16], sel=load, out=mi16);
    DFF(in=mi16, out=loop[16], out=out[16]);
    Mux(a=loop[17], b=in[17], sel=load, out=mi17);
    DFF(in=mi17, out=loop[17], out=out[17]);
    Mux(a=loop[18], b=in[18], sel=load, out=mi18);
    DFF(in=mi18, out=loop[18], out=out[18]);
    Mux(a=loop[19], b=in[19], sel=load, out=mi19);
    DFF(in=mi19, out=loop[19], out=out[19]);
    Mux(a=loop[20], b=in[20], sel=load, out=mi20);
    DFF(in=mi20, out=loop[20], out=out[20]);
    Mux(a=loop[21], b=in[21], sel=load, out=mi21);
    DFF(in=mi21, out=loop[21], out=out[21]);
    Mux(a=loop[22], b=in[22], sel=load, out=mi22);
    DFF(in=mi22, out=loop[22], out=out[22]);
    Mux(a=loop[23], b=in[23], sel=load, out=mi23);
    DFF(in=mi23, out=loop[23], out=out[23]);
    Mux(a=loop[24], b=in[24], sel=load, out=mi24);
    DFF(in=mi24, out=loop[24], out=out[24]);
    Mux(a=loop[25], b=in[25], sel=load, out=mi25);
    DFF(in=mi25, out=loop[25], out=out[25]);
    Mux(a=loop[26], b=in[26], sel=load, out=mi26);
    DFF(in=mi26, out=loop[26], out=out[26]);
    Mux(a=loop[27], b=in[27], sel=load, out=mi27);
    DFF(in=mi27, out=loop[27], out=out[27]);
    Mux(a=loop[28], b=in[28], sel=load, out=mi28);
    DFF(in=mi28, out=loop[28], out=out[28]);
    Mux(a=loop[29], b=in[29], sel=load, out=mi29);
    DFF(in=mi29, out=loop[29], out=out[29]);
    Mux(a=loop[30], b=in[30], sel=load, out=mi30);
    DFF(in=mi30, out=loop[30], out=out[30]);
    Mux(a=loop[31], b=in[31], sel=load, out=mi31);
    DFF(in=mi31, out=loop[31], out=out[31]);
}
