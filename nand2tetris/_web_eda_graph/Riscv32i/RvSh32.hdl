    Mux(a=s4_31, b=fill, sel=sh[4], out=s5_31);
    // ---- 輸出選擇：right=1 直出 s5，right=0 反轉回來 ----
    Mux(a=s5_31, b=s5_0, sel=right, out=y[0]);
