// RvSh32：32 位元桶式移位器（RV32I sll/srl/sra 用）。
//   right＝0：左移（輸入先 bit 反轉、輸出再反轉回來，共用右移鏈）；
//   right＝1：右移；arith＝1 且右移時高位補 a[31]（SRA），否則補 0。
//   sh[4:0] 為位移量（取 b[4:0]，與 RV 一致只看低 5 位）。
CHIP RvSh32 {
    IN a[32], sh[5], right, arith;
    OUT y[32];

    PARTS:
    // ---- bit 反轉（SLL 路徑用；Or 當緩衝）----
    Or(a=a[31], b=false, out=ra0);
    Or(a=a[30], b=false, out=ra1);
    Or(a=a[29], b=false, out=ra2);
    Or(a=a[28], b=false, out=ra3);
    Or(a=a[27], b=false, out=ra4);
    Or(a=a[26], b=false, out=ra5);
    Or(a=a[25], b=false, out=ra6);
    Or(a=a[24], b=false, out=ra7);
    Or(a=a[23], b=false, out=ra8);
    Or(a=a[22], b=false, out=ra9);
    Or(a=a[21], b=false, out=ra10);
    Or(a=a[20], b=false, out=ra11);
    Or(a=a[19], b=false, out=ra12);
    Or(a=a[18], b=false, out=ra13);
    Or(a=a[17], b=false, out=ra14);
    Or(a=a[16], b=false, out=ra15);
    Or(a=a[15], b=false, out=ra16);
    Or(a=a[14], b=false, out=ra17);
    Or(a=a[13], b=false, out=ra18);
    Or(a=a[12], b=false, out=ra19);
    Or(a=a[11], b=false, out=ra20);
    Or(a=a[10], b=false, out=ra21);
    Or(a=a[9], b=false, out=ra22);
    Or(a=a[8], b=false, out=ra23);
    Or(a=a[7], b=false, out=ra24);
    Or(a=a[6], b=false, out=ra25);
    Or(a=a[5], b=false, out=ra26);
    Or(a=a[4], b=false, out=ra27);
    Or(a=a[3], b=false, out=ra28);
    Or(a=a[2], b=false, out=ra29);
    Or(a=a[1], b=false, out=ra30);
    Or(a=a[0], b=false, out=ra31);
    // ---- 輸入選擇：right=1 走 a，right=0 走反轉 ----
    Mux(a=ra0, b=a[0], sel=right, out=s0_0);
    Mux(a=ra1, b=a[1], sel=right, out=s0_1);
    Mux(a=ra2, b=a[2], sel=right, out=s0_2);
    Mux(a=ra3, b=a[3], sel=right, out=s0_3);
    Mux(a=ra4, b=a[4], sel=right, out=s0_4);
    Mux(a=ra5, b=a[5], sel=right, out=s0_5);
    Mux(a=ra6, b=a[6], sel=right, out=s0_6);
    Mux(a=ra7, b=a[7], sel=right, out=s0_7);
    Mux(a=ra8, b=a[8], sel=right, out=s0_8);
    Mux(a=ra9, b=a[9], sel=right, out=s0_9);
    Mux(a=ra10, b=a[10], sel=right, out=s0_10);
    Mux(a=ra11, b=a[11], sel=right, out=s0_11);
    Mux(a=ra12, b=a[12], sel=right, out=s0_12);
    Mux(a=ra13, b=a[13], sel=right, out=s0_13);
    Mux(a=ra14, b=a[14], sel=right, out=s0_14);
    Mux(a=ra15, b=a[15], sel=right, out=s0_15);
    Mux(a=ra16, b=a[16], sel=right, out=s0_16);
    Mux(a=ra17, b=a[17], sel=right, out=s0_17);
    Mux(a=ra18, b=a[18], sel=right, out=s0_18);
    Mux(a=ra19, b=a[19], sel=right, out=s0_19);
    Mux(a=ra20, b=a[20], sel=right, out=s0_20);
    Mux(a=ra21, b=a[21], sel=right, out=s0_21);
    Mux(a=ra22, b=a[22], sel=right, out=s0_22);
    Mux(a=ra23, b=a[23], sel=right, out=s0_23);
    Mux(a=ra24, b=a[24], sel=right, out=s0_24);
    Mux(a=ra25, b=a[25], sel=right, out=s0_25);
    Mux(a=ra26, b=a[26], sel=right, out=s0_26);
    Mux(a=ra27, b=a[27], sel=right, out=s0_27);
    Mux(a=ra28, b=a[28], sel=right, out=s0_28);
    Mux(a=ra29, b=a[29], sel=right, out=s0_29);
    Mux(a=ra30, b=a[30], sel=right, out=s0_30);
    Mux(a=ra31, b=a[31], sel=right, out=s0_31);
    // ---- 算術填補位 FILL＝arith&a[31] ----
    And(a=arith, b=a[31], out=fill);
    // ---- 五級右移（級 k 位移 2^k）----
    Mux(a=s0_0, b=s0_1, sel=sh[0], out=s1_0);
    Mux(a=s0_1, b=s0_2, sel=sh[0], out=s1_1);
    Mux(a=s0_2, b=s0_3, sel=sh[0], out=s1_2);
    Mux(a=s0_3, b=s0_4, sel=sh[0], out=s1_3);
    Mux(a=s0_4, b=s0_5, sel=sh[0], out=s1_4);
    Mux(a=s0_5, b=s0_6, sel=sh[0], out=s1_5);
    Mux(a=s0_6, b=s0_7, sel=sh[0], out=s1_6);
    Mux(a=s0_7, b=s0_8, sel=sh[0], out=s1_7);
    Mux(a=s0_8, b=s0_9, sel=sh[0], out=s1_8);
    Mux(a=s0_9, b=s0_10, sel=sh[0], out=s1_9);
    Mux(a=s0_10, b=s0_11, sel=sh[0], out=s1_10);
    Mux(a=s0_11, b=s0_12, sel=sh[0], out=s1_11);
    Mux(a=s0_12, b=s0_13, sel=sh[0], out=s1_12);
    Mux(a=s0_13, b=s0_14, sel=sh[0], out=s1_13);
    Mux(a=s0_14, b=s0_15, sel=sh[0], out=s1_14);
    Mux(a=s0_15, b=s0_16, sel=sh[0], out=s1_15);
    Mux(a=s0_16, b=s0_17, sel=sh[0], out=s1_16);
    Mux(a=s0_17, b=s0_18, sel=sh[0], out=s1_17);
    Mux(a=s0_18, b=s0_19, sel=sh[0], out=s1_18);
    Mux(a=s0_19, b=s0_20, sel=sh[0], out=s1_19);
    Mux(a=s0_20, b=s0_21, sel=sh[0], out=s1_20);
    Mux(a=s0_21, b=s0_22, sel=sh[0], out=s1_21);
    Mux(a=s0_22, b=s0_23, sel=sh[0], out=s1_22);
    Mux(a=s0_23, b=s0_24, sel=sh[0], out=s1_23);
    Mux(a=s0_24, b=s0_25, sel=sh[0], out=s1_24);
    Mux(a=s0_25, b=s0_26, sel=sh[0], out=s1_25);
    Mux(a=s0_26, b=s0_27, sel=sh[0], out=s1_26);
    Mux(a=s0_27, b=s0_28, sel=sh[0], out=s1_27);
    Mux(a=s0_28, b=s0_29, sel=sh[0], out=s1_28);
    Mux(a=s0_29, b=s0_30, sel=sh[0], out=s1_29);
    Mux(a=s0_30, b=s0_31, sel=sh[0], out=s1_30);
    Mux(a=s0_31, b=fill, sel=sh[0], out=s1_31);
    Mux(a=s1_0, b=s1_2, sel=sh[1], out=s2_0);
    Mux(a=s1_1, b=s1_3, sel=sh[1], out=s2_1);
    Mux(a=s1_2, b=s1_4, sel=sh[1], out=s2_2);
    Mux(a=s1_3, b=s1_5, sel=sh[1], out=s2_3);
    Mux(a=s1_4, b=s1_6, sel=sh[1], out=s2_4);
    Mux(a=s1_5, b=s1_7, sel=sh[1], out=s2_5);
    Mux(a=s1_6, b=s1_8, sel=sh[1], out=s2_6);
    Mux(a=s1_7, b=s1_9, sel=sh[1], out=s2_7);
    Mux(a=s1_8, b=s1_10, sel=sh[1], out=s2_8);
    Mux(a=s1_9, b=s1_11, sel=sh[1], out=s2_9);
    Mux(a=s1_10, b=s1_12, sel=sh[1], out=s2_10);
    Mux(a=s1_11, b=s1_13, sel=sh[1], out=s2_11);
    Mux(a=s1_12, b=s1_14, sel=sh[1], out=s2_12);
    Mux(a=s1_13, b=s1_15, sel=sh[1], out=s2_13);
    Mux(a=s1_14, b=s1_16, sel=sh[1], out=s2_14);
    Mux(a=s1_15, b=s1_17, sel=sh[1], out=s2_15);
    Mux(a=s1_16, b=s1_18, sel=sh[1], out=s2_16);
    Mux(a=s1_17, b=s1_19, sel=sh[1], out=s2_17);
    Mux(a=s1_18, b=s1_20, sel=sh[1], out=s2_18);
    Mux(a=s1_19, b=s1_21, sel=sh[1], out=s2_19);
    Mux(a=s1_20, b=s1_22, sel=sh[1], out=s2_20);
    Mux(a=s1_21, b=s1_23, sel=sh[1], out=s2_21);
    Mux(a=s1_22, b=s1_24, sel=sh[1], out=s2_22);
    Mux(a=s1_23, b=s1_25, sel=sh[1], out=s2_23);
    Mux(a=s1_24, b=s1_26, sel=sh[1], out=s2_24);
    Mux(a=s1_25, b=s1_27, sel=sh[1], out=s2_25);
    Mux(a=s1_26, b=s1_28, sel=sh[1], out=s2_26);
    Mux(a=s1_27, b=s1_29, sel=sh[1], out=s2_27);
    Mux(a=s1_28, b=s1_30, sel=sh[1], out=s2_28);
    Mux(a=s1_29, b=s1_31, sel=sh[1], out=s2_29);
    Mux(a=s1_30, b=fill, sel=sh[1], out=s2_30);
    Mux(a=s1_31, b=fill, sel=sh[1], out=s2_31);
    Mux(a=s2_0, b=s2_4, sel=sh[2], out=s3_0);
    Mux(a=s2_1, b=s2_5, sel=sh[2], out=s3_1);
    Mux(a=s2_2, b=s2_6, sel=sh[2], out=s3_2);
    Mux(a=s2_3, b=s2_7, sel=sh[2], out=s3_3);
    Mux(a=s2_4, b=s2_8, sel=sh[2], out=s3_4);
    Mux(a=s2_5, b=s2_9, sel=sh[2], out=s3_5);
    Mux(a=s2_6, b=s2_10, sel=sh[2], out=s3_6);
    Mux(a=s2_7, b=s2_11, sel=sh[2], out=s3_7);
    Mux(a=s2_8, b=s2_12, sel=sh[2], out=s3_8);
    Mux(a=s2_9, b=s2_13, sel=sh[2], out=s3_9);
    Mux(a=s2_10, b=s2_14, sel=sh[2], out=s3_10);
    Mux(a=s2_11, b=s2_15, sel=sh[2], out=s3_11);
    Mux(a=s2_12, b=s2_16, sel=sh[2], out=s3_12);
    Mux(a=s2_13, b=s2_17, sel=sh[2], out=s3_13);
    Mux(a=s2_14, b=s2_18, sel=sh[2], out=s3_14);
    Mux(a=s2_15, b=s2_19, sel=sh[2], out=s3_15);
    Mux(a=s2_16, b=s2_20, sel=sh[2], out=s3_16);
    Mux(a=s2_17, b=s2_21, sel=sh[2], out=s3_17);
    Mux(a=s2_18, b=s2_22, sel=sh[2], out=s3_18);
    Mux(a=s2_19, b=s2_23, sel=sh[2], out=s3_19);
    Mux(a=s2_20, b=s2_24, sel=sh[2], out=s3_20);
    Mux(a=s2_21, b=s2_25, sel=sh[2], out=s3_21);
    Mux(a=s2_22, b=s2_26, sel=sh[2], out=s3_22);
    Mux(a=s2_23, b=s2_27, sel=sh[2], out=s3_23);
    Mux(a=s2_24, b=s2_28, sel=sh[2], out=s3_24);
    Mux(a=s2_25, b=s2_29, sel=sh[2], out=s3_25);
    Mux(a=s2_26, b=s2_30, sel=sh[2], out=s3_26);
    Mux(a=s2_27, b=s2_31, sel=sh[2], out=s3_27);
    Mux(a=s2_28, b=fill, sel=sh[2], out=s3_28);
    Mux(a=s2_29, b=fill, sel=sh[2], out=s3_29);
    Mux(a=s2_30, b=fill, sel=sh[2], out=s3_30);
    Mux(a=s2_31, b=fill, sel=sh[2], out=s3_31);
    Mux(a=s3_0, b=s3_8, sel=sh[3], out=s4_0);
    Mux(a=s3_1, b=s3_9, sel=sh[3], out=s4_1);
    Mux(a=s3_2, b=s3_10, sel=sh[3], out=s4_2);
    Mux(a=s3_3, b=s3_11, sel=sh[3], out=s4_3);
    Mux(a=s3_4, b=s3_12, sel=sh[3], out=s4_4);
    Mux(a=s3_5, b=s3_13, sel=sh[3], out=s4_5);
    Mux(a=s3_6, b=s3_14, sel=sh[3], out=s4_6);
    Mux(a=s3_7, b=s3_15, sel=sh[3], out=s4_7);
    Mux(a=s3_8, b=s3_16, sel=sh[3], out=s4_8);
    Mux(a=s3_9, b=s3_17, sel=sh[3], out=s4_9);
    Mux(a=s3_10, b=s3_18, sel=sh[3], out=s4_10);
    Mux(a=s3_11, b=s3_19, sel=sh[3], out=s4_11);
    Mux(a=s3_12, b=s3_20, sel=sh[3], out=s4_12);
    Mux(a=s3_13, b=s3_21, sel=sh[3], out=s4_13);
    Mux(a=s3_14, b=s3_22, sel=sh[3], out=s4_14);
    Mux(a=s3_15, b=s3_23, sel=sh[3], out=s4_15);
    Mux(a=s3_16, b=s3_24, sel=sh[3], out=s4_16);
    Mux(a=s3_17, b=s3_25, sel=sh[3], out=s4_17);
    Mux(a=s3_18, b=s3_26, sel=sh[3], out=s4_18);
    Mux(a=s3_19, b=s3_27, sel=sh[3], out=s4_19);
    Mux(a=s3_20, b=s3_28, sel=sh[3], out=s4_20);
    Mux(a=s3_21, b=s3_29, sel=sh[3], out=s4_21);
    Mux(a=s3_22, b=s3_30, sel=sh[3], out=s4_22);
    Mux(a=s3_23, b=s3_31, sel=sh[3], out=s4_23);
    Mux(a=s3_24, b=fill, sel=sh[3], out=s4_24);
    Mux(a=s3_25, b=fill, sel=sh[3], out=s4_25);
    Mux(a=s3_26, b=fill, sel=sh[3], out=s4_26);
    Mux(a=s3_27, b=fill, sel=sh[3], out=s4_27);
    Mux(a=s3_28, b=fill, sel=sh[3], out=s4_28);
    Mux(a=s3_29, b=fill, sel=sh[3], out=s4_29);
    Mux(a=s3_30, b=fill, sel=sh[3], out=s4_30);
    Mux(a=s3_31, b=fill, sel=sh[3], out=s4_31);
    Mux(a=s4_0, b=s4_16, sel=sh[4], out=s5_0);
    Mux(a=s4_1, b=s4_17, sel=sh[4], out=s5_1);
    Mux(a=s4_2, b=s4_18, sel=sh[4], out=s5_2);
    Mux(a=s4_3, b=s4_19, sel=sh[4], out=s5_3);
    Mux(a=s4_4, b=s4_20, sel=sh[4], out=s5_4);
    Mux(a=s4_5, b=s4_21, sel=sh[4], out=s5_5);
    Mux(a=s4_6, b=s4_22, sel=sh[4], out=s5_6);
    Mux(a=s4_7, b=s4_23, sel=sh[4], out=s5_7);
    Mux(a=s4_8, b=s4_24, sel=sh[4], out=s5_8);
    Mux(a=s4_9, b=s4_25, sel=sh[4], out=s5_9);
    Mux(a=s4_10, b=s4_26, sel=sh[4], out=s5_10);
    Mux(a=s4_11, b=s4_27, sel=sh[4], out=s5_11);
    Mux(a=s4_12, b=s4_28, sel=sh[4], out=s5_12);
    Mux(a=s4_13, b=s4_29, sel=sh[4], out=s5_13);
