# tiny.ku — 單通道最小例（供 rvemu 單通道自檢：tid=0、ntid=1）
# lanes=1 時單通道算完全部元素，expect 全過，exit=0
lanes 1;
n 2;
mem A[2] @ 0x100 = i + 1;
mem B[2] @ 0x120 = 10 * (i + 1);
mem C[2] @ 0x140;
kernel tiny {
  for (i: int = tid; i < n; i += ntid) {
    C[i] = A[i] + B[i];
  }
  barrier();
}
expect {
  C[i] = A[i] + B[i];
}
