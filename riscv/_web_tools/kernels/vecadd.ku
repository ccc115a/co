# vecadd.ku — 向量加法（語意同 riscvgpu/prog.s：C[i]=A[i]+B[i]）
# A[i]=i+1、B[i]=10*(i+1)、C[i]=11*(i+1)；n=8。
# 驗證鏈：node cli/cu2rv.js kernels/vecadd.ku -o /tmp/vecadd.s
#   → node cli/rvasm.js /tmp/vecadd.s → 暫代 prog.hex 跑 iverilog（見 kernels/README.md）
lanes 4;
n 8;
mem A[8] @ 0x100 = i + 1;
mem B[8] @ 0x120 = 10 * (i + 1);
mem C[8] @ 0x140;
kernel vecadd {
  for (i: int = tid; i < n; i += ntid) {
    C[i] = A[i] + B[i];
  }
  barrier();
}
expect {
  C[i] = A[i] + B[i];
}
